<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kor" Width="980" Height="744" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0D0E12" Foreground="#ECEEF3"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                  ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="Muted" Color="#8A90A0"/>
    <SolidColorBrush x:Key="Faint" Color="#636A7A"/>
    <SolidColorBrush x:Key="Panel" Color="#13151B"/>
    <SolidColorBrush x:Key="Stroke" Color="#222631"/>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Baslik cubugu dugmeleri -->
    <Style x:Key="Cap" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C1F28"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Hap seklinde dugme -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#171A21" BorderBrush="#272B37" BorderThickness="1" CornerRadius="15" Padding="12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1F232D"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#262B37"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Yuvarlak renk dugmesi: Background = renk -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="ring" Stroke="#FFFFFF" StrokeThickness="2" Opacity="0"/>
              <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#33FFFFFF" StrokeThickness="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Satir icindeki kucuk silme dugmesi -->
    <Style x:Key="Del" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8">
              <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A1B20"/>
                <Setter Property="Foreground" Value="#FF6B7A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Efekt karti -->
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="GroupName" Value="fx"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10,12,11">
              <Grid>
                <StackPanel>
                  <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                             FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Accent}" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,5,0,0" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#181B23"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="#1A1D26"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sekme -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="GroupName" Value="tabs"/>
      <Setter Property="Margin" Value="0,0,26,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="14.5"
                         FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,10"/>
              <Border x:Name="bar" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#C9CDD8"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Anahtar -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Width="40" Height="22" CornerRadius="11" Background="#2A2E3A">
              <Ellipse x:Name="k" Width="16" Height="16" Fill="#9AA0AF" HorizontalAlignment="Left" Margin="3,0,3,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="k" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="k" Property="Fill" Value="#0D0E12"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kaydirici parcalari -->
    <Style x:Key="RbClear" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RbFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,-6,0"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Knob" TargetType="Thumb">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse Fill="#FFFFFF" Stroke="#0D0E12" StrokeThickness="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dolgulu kaydirici (parlaklik, hiz) -->
    <Style x:Key="Sl" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Background" Value="#242833"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource RbFill}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource RbClear}"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Duz kaydirici (renk tonu, doygunluk): Background = serit -->
    <Style x:Key="SlPlain" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="10" CornerRadius="5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource RbClear}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource RbClear}"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Hex kutusu -->
    <Style x:Key="Hex" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MaxLength" Value="7"/>
      <Setter Property="CharacterCasing" Value="Upper"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="#0F1116" BorderBrush="#2A2E3A" BorderThickness="1" CornerRadius="8" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="Tag" Value="bad">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF5566"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ince kaydirma cubugu -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#303544"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Baslik -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
        <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
        <TextBlock Text="Kor" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="Klavye ışığı" FontSize="12.5" Foreground="{StaticResource Faint}" Margin="10,1,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="powerTxt" Text="Açık" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ToggleButton x:Name="swPower" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,14,0"
                      WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="btnMin" Style="{StaticResource Cap}">
          <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
        </Button>
        <Button x:Name="btnClose" Style="{StaticResource Cap}">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Canli onizleme -->
    <StackPanel Grid.Row="1">
      <Grid x:Name="preview" Height="236" ClipToBounds="True"/>
      <TextBlock x:Name="statusText" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,18"/>
    </StackPanel>

    <!-- Sekmeler -->
    <Border Grid.Row="2" BorderBrush="#191C24" BorderThickness="0,0,0,1" Margin="28,0,28,20">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="tabLight" Style="{StaticResource Seg}" Content="Işık" IsChecked="True"/>
        <RadioButton x:Name="tabApps" Style="{StaticResource Seg}" Content="Uygulamalar"/>
        <RadioButton x:Name="tabSettings" Style="{StaticResource Seg}" Content="Ayarlar"/>
      </StackPanel>
    </Border>

    <!-- Isik -->
    <Grid x:Name="pageLight" Grid.Row="3" Margin="28,0,28,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource Lbl}" Text="EFEKT"/>
        <UniformGrid Columns="2" Margin="0,0,-8,0">
          <RadioButton x:Name="m0" Style="{StaticResource Tile}" Content="Sabit renk" Tag="Tek renk, sürekli yanar"/>
          <RadioButton x:Name="m1" Style="{StaticResource Tile}" Content="Nefes" Tag="Renk yavaşça yanıp söner"/>
          <RadioButton x:Name="m2" Style="{StaticResource Tile}" Content="Gökkuşağı" Tag="Tüm renkler arasında döner"/>
          <RadioButton x:Name="m7" Style="{StaticResource Tile}" Content="Aurora" Tag="Yeşil, turkuaz, mor arasında süzülür"/>
          <RadioButton x:Name="m3" Style="{StaticResource Tile}" Content="Tuş vuruşu" Tag="Bastıkça parlar, bırakınca söner"/>
          <RadioButton x:Name="m4" Style="{StaticResource Tile}" Content="Renk zarı" Tag="Her tuşta yeni bir renk"/>
          <RadioButton x:Name="m5" Style="{StaticResource Tile}" Content="Yazma ısısı" Tag="Hızlandıkça maviden kırmızıya"/>
          <RadioButton x:Name="m6" Style="{StaticResource Tile}" Content="Polis" Tag="Kırmızı ve mavi çakar"/>
        </UniformGrid>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Lbl}" Text="RENK"/>
        <Border x:Name="colorCard" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="swatch" Width="38" Height="38" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1"/>
              <TextBox x:Name="hexBox" Grid.Column="1" Style="{StaticResource Hex}" Height="38" Margin="10,0,10,0"/>
              <Button x:Name="btnSaveColor" Grid.Column="2" Style="{StaticResource Chip}" Content="Kaydet" Margin="0" Height="38"/>
            </Grid>
            <Slider x:Name="hueSl" Style="{StaticResource SlPlain}" Minimum="0" Maximum="360" Margin="0,14,0,0">
              <Slider.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FF0000" Offset="0"/>
                  <GradientStop Color="#FFFF00" Offset="0.1667"/>
                  <GradientStop Color="#00FF00" Offset="0.3333"/>
                  <GradientStop Color="#00FFFF" Offset="0.5"/>
                  <GradientStop Color="#0000FF" Offset="0.6667"/>
                  <GradientStop Color="#FF00FF" Offset="0.8333"/>
                  <GradientStop Color="#FF0000" Offset="1"/>
                </LinearGradientBrush>
              </Slider.Background>
            </Slider>
            <Slider x:Name="satSl" Style="{StaticResource SlPlain}" Minimum="0" Maximum="100" Margin="0,6,0,0"/>
            <WrapPanel x:Name="presetPanel" Margin="0,14,-8,0"/>
            <WrapPanel x:Name="customPanel" Margin="0,2,-8,-8"/>
          </StackPanel>
        </Border>

        <Grid Margin="0,18,0,0">
          <TextBlock Style="{StaticResource Lbl}" Text="PARLAKLIK" Margin="0"/>
          <TextBlock x:Name="brightTxt" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Grid>
        <Slider x:Name="brightSl" Style="{StaticResource Sl}" Minimum="0" Maximum="100" Margin="0,4,0,0"/>

        <Grid Margin="0,12,0,0">
          <TextBlock Style="{StaticResource Lbl}" Text="EFEKT HIZI" Margin="0"/>
          <TextBlock x:Name="speedTxt" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Grid>
        <Slider x:Name="speedSl" Style="{StaticResource Sl}" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Uygulamalar -->
    <Grid x:Name="pageApps" Grid.Row="3" Margin="28,0,28,24" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Lbl}" Text="UYGULAMA RENKLERİ"/>
        <TextBlock x:Name="emptyRules" Grid.Row="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20"
                   Text="Henüz kural yok. Sağdaki listeden bir uygulamaya tıkla; o uygulama öndeyken klavye, eklediğin andaki renge döner. Rengi sonradan hex kutusundan değiştirebilirsin."/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
          <StackPanel x:Name="rulesPanel"/>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Style="{StaticResource Lbl}" Text="AÇIK UYGULAMALAR"/>
          <Button x:Name="btnRefresh" Style="{StaticResource Chip}" Content="Yenile" HorizontalAlignment="Right" Margin="0,-8,0,6" FontSize="11.5"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
          <WrapPanel x:Name="runningPanel"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Renk kullanan efektlerde (sabit, nefes, tuş vuruşu) efekt korunur, yalnızca renk değişir. Diğer efektlerde klavye o renkte sabit yanar."/>
      </Grid>
    </Grid>

    <!-- Ayarlar -->
    <Grid x:Name="pageSettings" Grid.Row="3" Margin="28,0,28,24" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource Lbl}" Text="GENEL"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <StackPanel Margin="0,0,60,0">
              <TextBlock Text="Windows açılınca başlat" FontWeight="SemiBold" FontSize="13.5"/>
              <TextBlock Text="Tepside sessizce açılır ve son ayarını uygular." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleButton x:Name="swAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <TextBlock Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="2,14,0,0" LineHeight="19"
                   Text="Pencereyi kapatınca program tepside çalışmaya devam eder. Tamamen kapatmak için tepsi simgesine sağ tıklayıp Çıkış'ı seç."/>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Lbl}" Text="KISAYOLLAR"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
              <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Fn  +  Numpad −" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Parlaklığı azalt" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
